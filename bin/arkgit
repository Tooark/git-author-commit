#!/usr/bin/env bash
# =============================================================
# arkgit - Ferramenta de reescrita de histórico Git
# 100% puro: usa apenas comandos nativos do Git (filter-branch).
# Sem dependências de Python, git-filter-repo ou similares.
#
# Comandos:
#   arkgit author <old-email> <new-email> "<new-name>"
#   arkgit erase [--dry-run] <path> [path...]
#   arkgit help
# =============================================================
set -euo pipefail

VERSION="2.0.0"

# ---------------------------------------------------------- utils

usage() {
  cat <<EOF
arkgit v$VERSION - Reescrita de histórico Git sem dependências

Uso:
  arkgit author <old-email> <new-email> "<new-name>"
      Substitui autor e committer em todo o histórico.

  arkgit erase [--dry-run] <path> [path...]
      Remove arquivos ou pastas de TODO o histórico.
      Aceita arquivos, pastas e globs (entre aspas), misturados:
        arkgit erase .env secrets/ "certs/*.pem"

  arkgit help
      Mostra esta ajuda.

Opções do erase:
  --dry-run   Apenas lista os commits que tocam nos caminhos,
              sem reescrever nada.
EOF
}

fail() { echo "Erro: $*" >&2; exit 1; }

require_repo() {
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 \
    || fail "este diretório não é um repositório Git."
}

confirm_rewrite() {
  echo ""
  echo "ATENÇÃO: esta operação reescreve TODO o histórico do repositório."
  echo "Todos os hashes de commit vão mudar e será necessário force push."
  read -r -p "Digite 'SIM' para continuar: " CONFIRM
  [ "$CONFIRM" = "SIM" ] || { echo "Operação cancelada."; exit 0; }
}

stash_if_dirty() {
  STASHED=0
  if [ -n "$(git status --porcelain)" ]; then
    echo "Mudanças locais detectadas. Criando stash 'arkgit'..."
    git stash push -u -m "arkgit"
    STASHED=1
  fi
}

stash_reminder() {
  if [ "${STASHED:-0}" -eq 1 ]; then
    echo ""
    echo "Lembrete: suas mudanças locais estão no stash. Recupere com: git stash pop"
  fi
}

cleanup_refs() {
  echo "Limpando refs de backup e histórico antigo..."
  git for-each-ref --format="%(refname)" refs/original/ \
    | xargs -r -n 1 git update-ref -d
  git reflog expire --expire=now --all
  git gc --prune=now --aggressive
}

push_hint() {
  echo ""
  echo "Processo concluído com sucesso!"
  echo "Para publicar o novo histórico:"
  echo "  git push origin --force-with-lease --all"
  echo "  git push origin --force-with-lease --tags"
}

# Escapa um valor para uso seguro dentro de aspas simples no sh
sh_quote() {
  printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

# ---------------------------------------------------------- author

cmd_author() {
  local OLD_EMAIL="${1:-}" NEW_EMAIL="${2:-}" NEW_NAME="${3:-}"
  [ -n "$OLD_EMAIL" ] && [ -n "$NEW_EMAIL" ] && [ -n "$NEW_NAME" ] \
    || fail "uso: arkgit author <old-email> <new-email> \"<new-name>\""

  require_repo

  echo "=== arkgit author ==="
  echo "Old Email : $OLD_EMAIL"
  echo "New Email : $NEW_EMAIL"
  echo "New Name  : $NEW_NAME"

  confirm_rewrite
  stash_if_dirty

  echo "Executando git filter-branch (env-filter)..."
  export FILTER_BRANCH_SQUELCH_WARNING=1
  git filter-branch -f --env-filter "
if [ \"\$GIT_COMMITTER_EMAIL\" = \"$OLD_EMAIL\" ]; then
  export GIT_COMMITTER_NAME=\"$NEW_NAME\"
  export GIT_COMMITTER_EMAIL=\"$NEW_EMAIL\"
fi
if [ \"\$GIT_AUTHOR_EMAIL\" = \"$OLD_EMAIL\" ]; then
  export GIT_AUTHOR_NAME=\"$NEW_NAME\"
  export GIT_AUTHOR_EMAIL=\"$NEW_EMAIL\"
fi
" --tag-name-filter cat -- --branches --tags

  cleanup_refs
  stash_reminder
  push_hint
  echo "Verifique com: git log -5 --format=\"%h %an <%ae> | committer: %cn <%ce>\""
}

# ---------------------------------------------------------- erase

cmd_erase() {
  local DRY_RUN=0
  local PATHS=()

  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) DRY_RUN=1 ;;
      --) shift; while [ $# -gt 0 ]; do PATHS+=("$1"); shift; done; break ;;
      -*) fail "opção desconhecida: $1" ;;
      *) PATHS+=("$1") ;;
    esac
    shift
  done

  [ "${#PATHS[@]}" -gt 0 ] \
    || fail "uso: arkgit erase [--dry-run] <path> [path...]"

  require_repo

  echo "=== arkgit erase ==="
  echo "Caminhos a remover do histórico:"
  local p
  for p in "${PATHS[@]}"; do echo "  - $p"; done

  if [ "$DRY_RUN" -eq 1 ]; then
    echo ""
    echo "[dry-run] Commits que tocam nesses caminhos:"
    git log --all --oneline -- "${PATHS[@]}" || true
    echo ""
    echo "[dry-run] Nada foi alterado. Remova --dry-run para executar."
    return 0
  fi

  confirm_rewrite
  stash_if_dirty

  # Monta a lista de caminhos com quoting seguro para o sh do filtro
  local QUOTED=""
  for p in "${PATHS[@]}"; do
    QUOTED="$QUOTED $(sh_quote "$p")"
  done

  echo "Executando git filter-branch (index-filter)..."
  export FILTER_BRANCH_SQUELCH_WARNING=1
  git filter-branch -f \
    --index-filter "git rm -r --cached --ignore-unmatch --$QUOTED" \
    --prune-empty --tag-name-filter cat -- --branches --tags

  cleanup_refs
  stash_reminder
  push_hint
  echo ""
  echo "IMPORTANTE: se o conteúdo removido era uma chave/segredo,"
  echo "considere-o COMPROMETIDO e revogue/rotacione mesmo assim."
}

# ---------------------------------------------------------- main

case "${1:-help}" in
  author) shift; cmd_author "$@" ;;
  erase)  shift; cmd_erase "$@" ;;
  help|-h|--help) usage ;;
  -v|--version) echo "arkgit v$VERSION" ;;
  *) fail "comando desconhecido: $1 (use 'arkgit help')" ;;
esac
